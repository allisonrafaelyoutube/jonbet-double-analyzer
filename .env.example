# Variáveis de ambiente (exemplo)
# Copie para .env localmente. No Render/Netlify, configure no painel.

# Supabase (Render usa service role; Netlify usa anon)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Poller
POLL_MS=2000
POLL_TIMEOUT_MS=8000
PORT=8787
JONBET_DOUBLE_API=https://jonbet.bet.br/api/singleplayer-originals/originals/roulette_games/recent/1

# Netlify (só front)
# VITE_ ou window config — ver docs/DEPLOY-CLOUD.md
